{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "provider": {
    "agentrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter",
      "options": {
        "baseURL": "https://co.agentrouter.org/v1"
      },
      "models": {
        "gpt-5.5": { "name": "GPT-5.5" },
        "kimi-k2.6": { "name": "Kimi K2.6" },
        "glm-5.1": { "name": "GLM-5.1" },
        "step3p5-code-alpha": { "name": "Step3.5 Code Alpha" }
      }
    }
  },
  "references": {
    "hunt": {
      "path": "./hunt",
      "description": "Active hunts: per-target scope, module maps, findings ledger, PoCs, and report drafts"
    },
    "classroom": {
      "path": "./classroom",
      "description": "Contest learning workspaces: per-contest findings index, source-grounded investigations, navigation maps, discussion state"
    }
  }
}
